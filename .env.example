# Настройки для docker-compose (скопируйте в .env рядом с docker-compose.yml).
# Локального dev-запуска (start.bat) этот файл не касается —
# там свои backend/.env и frontend/.env.

# Обязательно: секрет для подписи JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=

# Время жизни токена в минутах (по умолчанию 30 дней)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Web Push (VAPID). Пустые значения = пуши выключены.
# Генерация: docker compose exec backend python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
